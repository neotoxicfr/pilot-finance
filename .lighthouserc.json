{
  "ci": {
    "collect": {
      "settings": {
        "chromeFlags": [
          "--headless=new",
          "--no-sandbox",
          "--disable-gpu",
          "--disable-dev-shm-usage",
          "--disable-software-rasterizer"
        ],
        "maxWaitForFcp": 60000,
        "maxWaitForLoad": 60000,
        "throttlingMethod": "provided"
      }
    }
  }
}
